# CoreOS Pipeline Assistant Environment Variables

# Required for both Slack and CLI modes
JENKINS_URL=https://your-jenkins-server.com
JENKINS_TOKEN=your_jenkins_api_token
JENKINS_VERIFY_SSL=true  # Set to false for self-signed certificates

# Required for Slack mode only
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Optional: LLM API keys (needed for analyze command)
GEMINI_API_KEY=your_gemini_api_key
# OR
OPENROUTER_API_KEY=your_openrouter_api_key
